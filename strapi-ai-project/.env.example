# Server Configuration
HOST=0.0.0.0
PORT=1337

# Security Keys (Auto-generated on first run)
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database Configuration
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Strapi AI Integration
# Get your API key from: https://strapi.io/ai
STRAPI_AI_API_KEY=your-strapi-ai-api-key-here

# Strapi Cloud Transfer (Optional)
# For transferring data to/from Strapi Cloud
# Get transfer token from: Settings → Transfer Tokens
STRAPI_TRANSFER_URL=https://your-project.strapiapp.com/admin
STRAPI_TRANSFER_TOKEN=your-transfer-token-here
