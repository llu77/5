{
  "collectionName": "components_sections_testimonials",
  "info": {
    "displayName": "Testimonial",
    "description": "Customer testimonial component",
    "icon": "quote"
  },
  "options": {},
  "attributes": {
    "quote": {
      "type": "text",
      "required": true,
      "maxLength": 500
    },
    "authorName": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "authorRole": {
      "type": "string",
      "required": false,
      "maxLength": 100
    },
    "authorPhoto": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "companyLogo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5,
      "required": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
