{
  "collectionName": "components_sections_feature_grids",
  "info": {
    "displayName": "Feature Grid",
    "description": "Grid of features or services",
    "icon": "grid"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "subtitle": {
      "type": "text",
      "required": false,
      "maxLength": 300
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "sections.feature-item",
      "required": true,
      "min": 1
    },
    "displayStyle": {
      "type": "enumeration",
      "enum": ["grid", "list", "carousel"],
      "default": "grid"
    },
    "columns": {
      "type": "enumeration",
      "enum": ["2", "3", "4"],
      "default": "3"
    },
    "backgroundColor": {
      "type": "enumeration",
      "enum": ["white", "light", "dark", "primary"],
      "default": "white"
    }
  }
}
