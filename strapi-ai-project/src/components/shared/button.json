{
  "collectionName": "components_shared_buttons",
  "info": {
    "displayName": "Button",
    "description": "Reusable button component with style variants",
    "icon": "cursor"
  },
  "options": {},
  "attributes": {
    "text": {
      "type": "string",
      "required": true,
      "maxLength": 50
    },
    "url": {
      "type": "string",
      "required": true
    },
    "style": {
      "type": "enumeration",
      "enum": ["primary", "secondary", "tertiary"],
      "default": "primary",
      "required": true
    },
    "size": {
      "type": "enumeration",
      "enum": ["small", "medium", "large"],
      "default": "medium",
      "required": true
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    }
  }
}
