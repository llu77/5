{
  "collectionName": "components_shared_links",
  "info": {
    "displayName": "Link",
    "description": "Reusable link component with optional icon",
    "icon": "link"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "url": {
      "type": "string",
      "required": true
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "opensInNewTab": {
      "type": "boolean",
      "default": false
    }
  }
}
